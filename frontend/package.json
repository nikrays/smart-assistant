{
  "name": "smart-assistant-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode pages",
    "typecheck": "tsc --noEmit",
    "test:drafts": "node ../scripts/check-drafts.mjs",
    "test:numbers": "node ../scripts/check-number-format.mjs",
    "test:pages": "node ../scripts/check-pages-demo.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@tanstack/react-query": "5.106.1",
    "@tanstack/react-virtual": "3.14.26",
    "decimal.js": "10.6.0",
    "driver.js": "1.11.0",
    "lucide-react": "1.69.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.0",
    "vite": "6.4.5"
  }
}
